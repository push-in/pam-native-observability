    "permissions": ["android.permission.INTERNET", "android.permission.ACCESS_NETWORK_STATE"],
    "manifest": "android/src/main/AndroidManifest.xml",
    "consumerRules": "android/consumer-rules.pro",
    "dependencies": ["io.sentry:sentry-android-core:8.50.1", "io.sentry:sentry-android-ndk:8.50.1"],
    "sourceDirs": ["android/src/main/kotlin"]
  },
  "ios": {"minimumVersion": "15.0", "sourceDirs": ["ios/Sources"]},
  "idl": "pam-native.idl.json",
  "modules": [{"name": "observability", "class": "dev.pam.observability.ObservabilityModule", "iosClass": "ObservabilityModule"}],
  "views": []
}
