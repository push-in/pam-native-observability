{
    "name": "pushinbr/pam-native-observability",
    "description": "Vendor-neutral telemetry and a native Sentry exporter (crashes, ANRs, NDK, PHP errors) for PAM Native.",
    "type": "pam-native-plugin",
    "keywords": [
        "pam-native",
        "observability",
        "opentelemetry",
        "sentry",
        "crash-reporting"
    ],
    "license": "Apache-2.0",
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "pushinbr/pam-native": "^1.0.35"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "pushinbr/pam-native-testing": "^0.2.0"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Native\\Observability\\": "src/"
        }
    },
    "extra": {
        "pam-native": {
            "plugin": "pam-native.plugin.json"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "check": [
            "@test",
            "@analyse"
        ],
        "test": "php tests/run.php"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    }
}
