{
    "name": "pushinbr/pam-native-observability",
    "description": "Vendor-neutral traces, metrics, logs and crash context for PAM Native.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "pushinbr/pam-native": "^0.6.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Native\\Observability\\": "src/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "check": [
            "@test",
            "@analyse"
        ],
        "test": "php tests/run.php"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    }
}
