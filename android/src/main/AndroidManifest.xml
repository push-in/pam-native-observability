<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application>
        <!-- Sentry is configured from PHP (Observability::exporter); never auto-init from the manifest. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
        <provider
            android:name="io.sentry.android.core.SentryInitProvider"
            android:authorities="${applicationId}.SentryInitProvider"
            tools:node="remove" />
        <!-- Restores the persisted exporter before the PHP runtime boots. -->
        <provider
            android:name="dev.pam.observability.SentryBootstrap"
            android:authorities="${applicationId}.pam-observability"
            android:exported="false"
            android:initOrder="200" />
    </application>
</manifest>
